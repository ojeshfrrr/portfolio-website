# Public business email for project enquiries.
NEXT_PUBLIC_CONTACT_EMAIL=workwithovio@gmail.com
# Full international number, including country code. Optional.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Confirmed HTTPS origin, e.g. your registered domain. Leave empty before launch.
NEXT_PUBLIC_SITE_URL=
# Set true only after the server-side Resend values below are configured.
NEXT_PUBLIC_CONTACT_FORM_ENABLED=false
# Server-only Resend configuration. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=workwithovio@gmail.com
